 "code": {
  "e7_verify_py_sha256": "fa6da9eee06ea47b0d68975d55ad9520f6bf60ab56075848788df03f18a87156",
  "monitor_py_sha256": "1863ae9df90efb8985dd8a4bccbe79eeab9fe224f880f3e07726d1e960b80410",
  "combiner_sha256": "e469102a6221df7463ee5fe9b3cf1dac8cd12291524601f39e1204e3c7f9104d",
  "combiner_source": "\"\"\"Combine `exp/stages/e7_verify.py late-delays` over nine earlier real-deployment runs into one result file, plus the\ncommit-order check over the ten shipped extracts. Numbers come from the tool's output; no LATE_BOUND is chosen here.\nusage: e7_late_delays_prior.py OUTDIR_FOR_PER_RUN_FILES   (writes exp/out/e7_late_delays_prior.json, never overwrites)\"\"\"\nimport datetime, glob, hashlib, json, os, sqlite3, subprocess, sys\nREPO = \"<artifact-root>\"\nEXP = os.path.join(os.path.dirname(REPO), \"HOMEPROV-P13-exp\")\nOUT = os.path.join(REPO, \"exp\", \"out\", \"e7_late_delays_prior.json\")\nTOOL = os.path.join(REPO, \"exp\", \"stages\", \"e7_verify.py\")\nper_dir = sys.argv[1]\nif os.path.exists(OUT):\n    raise SystemExit(\"refusing to overwrite \" + OUT)\nsha = lambda p: hashlib.sha256(open(p, \"rb\").read()).hexdigest()\nS = os.path.join(REPO, \"reproduce\", \"snapshots\")\nRUNS = [  # run, recorder copy, chain, result file holding the window\n    (\"e_d_clo\", os.path.join(S, \"e_d_clo.db\"), os.path.join(S, \"e_d_clo.chain.jsonl\"), \"e_d_clo_other_principal_real.json\"),\n    (\"e_c_clo\", os.path.join(S, \"e_c_clo.db\"), os.path.join(S, \"e_c_clo.chain.jsonl\"), \"e_c_clo_other_principal_real.json\"),\n    (\"e_ps_clo\", os.path.join(S, \"e_ps_clo.db\"), os.path.join(S, \"e_ps_clo.chain.jsonl\"), \"e_ps_clo_detection.json\"),\n    (\"e_psr_clo\", os.path.join(S, \"e_psr_clo.db\"), os.path.join(S, \"e_psr_clo.chain.jsonl\"), \"e_psr_clo_detection.json\"),\n    (\"e_c_auth\", os.path.join(S, \"e_c_auth.db\"), os.path.join(S, \"e_c_auth.chain.jsonl\"), \"e_c_auth_other_principal_real.json\"),\n    (\"e_ps_auth\", os.path.join(S, \"e_ps_auth.db\"), os.path.join(S, \"e_ps_auth.chain.jsonl\"), \"e_ps_auth_detection.json\"),\n    (\"e3_g0_clo\", os.path.join(EXP, \"e3\", \"e3_g0_clo\", \"ec_verify\", \"recorder.db\"), os.path.join(EXP, \"e3\", \"e3_g0_clo\", \"chain.jsonl\"),\n     \"e3_g0_clo_other_principal_real.json\"),\n    (\"e3_g2_clo\", os.path.join(EXP, \"e3\", \"e3_g2_clo\", \"ec_verify\", \"recorder.db\"), os.path.join(EXP, \"e3\", \"e3_g2_clo\", \"chain.jsonl\"),\n     \"e3_g2_clo_other_principal_real.json\"),\n    (\"e1_psr_clo\", os.path.join(EXP, \"e1\", \"e1_psr_clo\", \"ps_verify\", \"recorder.db\"), os.path.join(EXP, \"e1\", \"e1_psr_clo\", \"chain.jsonl\"),\n     \"e1_psr_clo_detection.json\"),\n]\n\n\ndef rel(p):\n    return (os.path.relpath(p, REPO) if p.startswith(REPO + os.sep)\n            else \"HOMEPROV-P13-exp/\" + os.path.relpath(p, EXP))\n\n\nruns = {}\nfor run, db, chain, res in RUNS:\n    w = json.load(open(os.path.join(REPO, \"exp\", \"out\", res)))[\"window\"]\n    t0, t1, tsnap = w[\"t_start\"], w[\"t_end\"], w[\"recorder_snapshot_at\"]\n    out = os.path.join(per_dir, \"late_delays_%s.json\" % run)\n    cmd = [sys.executable, TOOL, \"late-delays\", \"--chain\", chain, \"--db\", db, \"--window\", repr(t0), repr(t1),\n           \"--snapshot-at\", repr(tsnap), \"--out\", out]\n    subprocess.run(cmd, check=True)\n    d = json.load(open(out))\n    runs[run] = {\"inputs\": {\"recorder\": rel(db), \"recorder_sha256\": sha(db), \"chain\": rel(chain), \"chain_sha256\": sha(chain),\n                            \"window_from\": \"exp/out/\" + res, \"window_file_sha256\": sha(os.path.join(REPO, \"exp\", \"out\", res)),\n                            \"window\": [t0, t1, tsnap]},\n                 \"scheme\": d[\"params\"][\"scheme\"],\n                 \"n_late_rows\": d[\"n_late_rows\"], \"max_delay_lower_s\": d[\"max_delay_lower_s\"],\n                 \"max_delay_upper_s\": d[\"max_delay_upper_s\"], \"rows_without_upper\": d[\"rows_without_upper\"],\n                 \"segments_not_explained_by_late_rows\": d[\"segments_not_explained_by_late_rows\"],\n                 \"late_rows\": d[\"late_rows\"],\n                 \"tool_output_sha256\": sha(out),\n                 \"command\": \"python3 exp/stages/e7_verify.py late-delays --chain %s --db %s --window %r %r --snapshot-at %r --out FILE\"\n                            % (rel(chain), rel(db), t0, t1, tsnap)}\n\n# Commit-order check over the ten shipped extracts: a row whose timestamp is older than that of an earlier-keyed row of\n# the same table (keys are assigned in commit order, so such a row would have been committed after a newer one).\norder = {}\nfor db in sorted(glob.glob(os.path.join(S, \"*.db\"))):\n    con = sqlite3.connect(\"file:%s?mode=ro&immutable=1\" % db, uri=True)\n    r = {\"sha256\": sha(db)}\n    for t, k, c in ((\"states\", \"state_id\", \"last_updated_ts\"), (\"events\", \"event_id\", \"time_fired_ts\")):\n        mx, lags, n = None, [], 0\n        for key, ts in con.execute(\"SELECT %s, %s FROM %s ORDER BY %s\" % (k, c, t, k)):\n            n += 1\n            if ts is None:\n                continue\n            if mx is not None and mx - ts > 0:\n                lags.append(mx - ts)\n            mx = ts if mx is None else max(mx, ts)\n        r[t] = {\"rows\": n, \"rows_older_than_an_earlier_keyed_row\": len(lags), \"max_lag_s\": max(lags) if lags else 0.0}\n    con.close()\n    order[rel(db)] = r\n\nlo = [v[\"max_delay_lower_s\"] for v in runs.values() if v[\"max_delay_lower_s\"] is not None]\nup = [v[\"max_delay_upper_s\"] for v in runs.values() if v[\"max_delay_upper_s\"] is not None]\narg = lambda key, m: sorted(k for k, v in runs.items() if v[key] == m)\nresult = {\n    \"item\": \"E7 prior evidence for LATE_BOUND: benign late-row delays of nine earlier real-deployment runs\",\n    \"generated\": datetime.datetime.now(datetime.timezone.utc).isoformat(),\n    \"method\": (\"exp/stages/e7_verify.py late-delays. In every anchored one-second segment whose root fails with more rows \"\n               \"now than anchored, the late-row hypothesis (drop the j newest state rows and k-j newest event rows by key) \"\n               \"is tried; when a candidate reproduces the anchored root, the dropped rows arrived after the seal. Each such \"\n               \"row's delay is bracketed: lower = sealing record ts - row ts (that copy lacked the row; the record ts is \"\n               \"taken just after the copy); upper = ts of the last record before the first record that provably held the \"\n               \"row (it sealed an intact segment holding a row of the same table with a key at or above it) - row ts.\"),\n    \"late_bound\": \"not chosen here; fixed separately in the E7 pre-registration\",\n    \"runs\": runs,\n    \"overall\": {\"n_runs\": len(runs), \"n_late_rows\": sum(v[\"n_late_rows\"] for v in runs.values()),\n                \"max_delay_lower_s\": max(lo) if lo else None, \"max_delay_lower_run\": arg(\"max_delay_lower_s\", max(lo)) if lo else None,\n                \"max_delay_upper_s\": max(up) if up else None, \"max_delay_upper_run\": arg(\"max_delay_upper_s\", max(up)) if up else None,\n                \"rows_without_upper\": sum(v[\"rows_without_upper\"] for v in runs.values()),\n                \"segments_not_explained_by_late_rows\": sum(len(v[\"segments_not_explained_by_late_rows\"]) for v in runs.values())},\n    \"commit_order_check\": {\"what\": \"rows whose timestamp is older than that of an earlier-keyed row of the same table, \"\n                                   \"over the ten shipped window extracts (reproduce/snapshots)\",\n                           \"extracts\": order,\n                           \"total_rows_older_than_an_earlier_keyed_row\": sum(\n                               v[t][\"rows_older_than_an_earlier_keyed_row\"] for v in order.values() for t in (\"states\", \"events\"))},\n    \"code\": {\"e7_verify_py_sha256\": sha(TOOL), \"monitor_py_sha256\": sha(os.path.join(REPO, \"monitor\", \"monitor.py\")),\n             \"combiner_sha256\": sha(os.path.abspath(__file__)), \"combiner_source\": open(os.path.abspath(__file__)).read()},\n    \"python\": sys.version.split()[0],\n}\nwith open(OUT, \"x\") as fh:\n    json.dump(result, fh, indent=1)\nprint(json.dumps(result[\"overall\"]))\nprint(\"sha256\", sha(OUT))\n"
 },
 "python": "3.13.11"
}