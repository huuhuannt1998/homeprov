 "definitions": {
  "total": "wall time of monitor.tick() for one poll (everything the poll does)",
  "phase_*": "time inside that monitor function during the poll (timers only; nested calls counted in both, e.g. watermark inside keylog_poll is not nested, validate_copy holds quick_check)",
