 "definitions": {
  "total": "wall time of monitor.tick() for one poll (everything the poll does)",
  "phase_*": "time inside that monitor function during the poll (timers only; nested calls counted in both, e.g. watermark inside keylog_poll is not nested, validate_copy holds quick_check)",
  "proc_read_bytes/write_bytes": "from /proc/self/io: bytes the monitor process caused to be fetched from / sent to storage in the poll (page-cache hits are not reads)",
  "proc_rchar/wchar": "bytes passed through read/write-type system calls (includes page-cache hits)",
  "cgroup_rbytes/wbytes": "the container's cgroup io.stat on the VM disk (includes writeback)",
  "bytes_written_per_hour": "sum over the measured polls / the measured window's seconds * 3600: the run's measured rate, expressed per hour"
 }
